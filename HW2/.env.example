# Sao chép file này thành ".env" rồi điền giá trị thật.
# KHÔNG commit file .env lên Git.

# Chuỗi kết nối MongoDB
# - Local:  mongodb://127.0.0.1:27017/swipe_deck
# - Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/swipe_deck
MONGODB_URI=

# Cổng chạy Express
PORT=3001

# Origin của client Vite (dùng cho CORS khi không đi qua proxy)
CLIENT_ORIGIN=http://localhost:5173